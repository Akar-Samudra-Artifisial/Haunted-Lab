# Names and placeholders only. Copy to .env and fill in; never commit real values.
# Supervisor bearer tokens: at least 16 characters each, different from each other.
CHAOS_TOKEN=change-me-chaos-token
LAB_READ_TOKEN=change-me-read-token
SUPERVISOR_PORT=4100
GATE_PORT=4001
ORDERS_PORT=4002
PAYMENTS_PORT=4003
LEDGER_PORT=4004
SERVICE_BIND_HOST=127.0.0.1
TRAFFIC_RPS=5
# Optional overrides (defaults: this checkout, data/, worktrees/)
# LAB_REPO_DIR=
# LAB_DATA_DIR=
# LAB_WORKTREES_DIR=
# LAB_ECHO_CHILD_OUTPUT=1
# Fix deploys (spec fix-deploy): public origin of incident/* refs, optional OS user for fix code (EC2)
# LAB_ORIGIN_URL=https://github.com/Akar-Samudra-Artifisial/Haunted-Lab.git
# FIX_RUN_AS_USER=
# LAB_ALLOW_FILE_ORIGIN=0   (tests only)
# deploy/compose.yaml
# PROMETHEUS_PORT=9090
# LAB_HOST_ADDR=host-gateway
